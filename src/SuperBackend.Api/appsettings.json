{
    "AllowedHosts": "localhost;127.0.0.1",
    "Identity": {
        "AllowRegistration": false
    },
    "Modules": {
        "AdminPanel": false,
        "Notes": false
    },
    "RateLimits": {
        "RequestsPerMinute": 180,
        "IdentityRequestsPerMinute": 20
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    }
}
